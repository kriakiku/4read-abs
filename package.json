{
  "name": "4read-abs",
  "version": "0.1.15",
  "description": "Scraper for 4read.org audiobook metadata with Audiobookshelf sidecar sync and subscriptions",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --target=bun-linux-x64 --minify --sourcemap ./src/index.ts --outfile dist/4read-abs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "hono": "^4.13.5",
    "yaml": "^2.8.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  }
}
